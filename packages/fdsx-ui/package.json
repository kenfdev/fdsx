{
  "name": "fdsx-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone web UI for visualizing fdsx workflow YAML files as interactive directed graphs",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/add-shebang.mjs",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "vite",
    "dev:server": "tsx src/server/cli.ts",
    "dev:all": "npm run build:client && tsx src/server/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No linter configured yet'"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.0",
    "@xyflow/react": "^12.0.0",
    "commander": "^13.0.0",
    "express": "^5.0.0",
    "js-yaml": "^4.1.0",
    "open": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "bin": {
    "fdsx-ui": "./dist/server/server/cli.js"
  }
}
