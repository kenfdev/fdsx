{
  "name": "fdsx-ui",
  "version": "0.2.1",
  "type": "module",
  "description": "Standalone web UI for visualizing fdsx workflow YAML files as interactive directed graphs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenfdev/fdsx.git",
    "directory": "packages/fdsx-ui"
  },
  "homepage": "https://github.com/kenfdev/fdsx/tree/main/packages/fdsx-ui#readme",
  "bugs": {
    "url": "https://github.com/kenfdev/fdsx/issues"
  },
  "keywords": [
    "fdsx",
    "workflow",
    "visualization",
    "yaml",
    "cli"
  ],
  "files": [
    "dist",
    "npm-shrinkwrap.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/add-shebang.mjs",
    "prepublishOnly": "npm run build",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "vite",
    "dev:server": "tsx src/server/cli.ts",
    "dev:all": "npm run build:client && tsx src/server/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No linter configured yet'"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.0.0",
    "@xyflow/react": "12.10.2",
    "commander": "14.0.3",
    "express": "5.2.1",
    "js-yaml": "4.1.1",
    "open": "10.2.0",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/express": "5.0.6",
    "@types/js-yaml": "4.0.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/supertest": "7.2.0",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "25.0.1",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vite": "6.4.2",
    "vitest": "4.1.5"
  },
  "bin": {
    "fdsx-ui": "./dist/server/server/cli.js"
  }
}
