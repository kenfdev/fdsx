# =============================================================================
# Team-shared base image. All app and personal Dockerfiles inherit from this.
#
# CUSTOMIZE: Add team-wide system dependencies here.
# Keep this minimal — project-specific deps go in Dockerfile.app.
# =============================================================================

FROM debian:bookworm-slim

 RUN apt-get update && apt-get install -y \
   curl \
   git \
   ca-certificates \
   zsh \
   sudo \
   locales \
   && rm -rf /var/lib/apt/lists/*

 RUN sed -i '/ja_JP.UTF-8/s/^# //' /etc/locale.gen && locale-gen
 ENV LANG=ja_JP.UTF-8
 ENV LC_ALL=ja_JP.UTF-8


# Create non-root user (handle pre-existing GID/UID gracefully)
ARG USERNAME=vscode
ARG USER_UID=1000
ARG USER_GID=$USER_UID
RUN groupadd --gid $USER_GID $USERNAME 2>/dev/null || true \
  && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME -s /bin/zsh 2>/dev/null || true \
  && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/$USERNAME

USER $USERNAME
WORKDIR /workspaces
